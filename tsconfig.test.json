{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2020",
    "jsx": "react-jsx",
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": [
    "src/lib/benchmarks.ts",
    "src/lib/calc.ts",
    "src/lib/compare.ts",
    "src/lib/reports.ts",
    "tests/**/*.ts"
  ]
}
