# --- TrueCost environment variables ---
# Copy to .env.local for local dev. Add the same keys in Netlify → Project configuration → Environment variables.

# Supabase (free tier) — from supabase.com dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OWNER_NOTIFY_EMAIL=you@example.com

# Resend (free tier) — owner notification emails. Optional in dev.
RESEND_API_KEY=re_your_key

# Cloudflare Turnstile (free) — spam shield. Optional in dev; enforced when set.
TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Canonical public site URL. Keep this aligned with SITE.url unless the owner changes the canonical host in code.
NEXT_PUBLIC_SITE_URL=https://trucost.netlify.app

# Resend sender identity. Use a domain/address verified in Resend; optional in dev.
RESEND_FROM_EMAIL=TrueCost <onboarding@resend.dev>

# Tracker access secret — unlocks the private /track dashboard. Leave blank here; set a strong random
# value (e.g. `openssl rand -hex 32`) only in Netlify environment variables or your local .env.local.
TRACKER_ACCESS_SECRET=
