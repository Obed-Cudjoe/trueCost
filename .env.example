# --- TrueCost environment variables ---
# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables.

# Supabase (free tier) — from supabase.com dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OWNER_NOTIFY_EMAIL=you@example.com
ADMIN_KEY=your-admin-key-here
# Resend (free tier) — owner notification emails. Optional in dev.
RESEND_API_KEY=re_your_key

# Cloudflare Turnstile (free) — spam shield. Optional in dev; enforced when set.
TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Public site URL (used for sitemap + OG tags). Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://truecost.vercel.app
